generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_DECLINED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_DELETED
  COMMENT_ADDED
  COMMENT_UPDATED
  COMMENT_DELETED
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique // unique index prevents concurrent duplicate registrations at the DB level
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  invitationsSent Invitation[]    @relation("InvitationInviter")
  acceptedInvitations Invitation[] @relation("InvitationAcceptee")
  createdTasks   Task[]          @relation("TaskCreator")
  assignedTasks  Task[]          @relation("TaskAssignee")
  comments       Comment[]
  activities     ActivityLog[]

  @@index([email])
}

// Rotating refresh tokens. Only the SHA-256 hash of the token secret is stored,
// never the raw token. Rows are retained after logout/revocation (revokedAt)
// for reuse-detection auditing; a maintenance job may purge rows older than 90d.
model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  familyId   String // rotation family: reuse of an old token revokes the whole family
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdByIp String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Projects & Membership
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ProjectMember[]
  invitations Invitation[]
  tasks       Task[]
  tags        Tag[]
  activities  ActivityLog[]

  @@index([ownerId])
  @@index([updatedAt])
}

// One row per user per project: DB-level protection against duplicate memberships.
model ProjectMember {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          ProjectRole @default(MEMBER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model Invitation {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String // invited e-mail address (lower-cased)
  role        ProjectRole      @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUserId String?
  acceptedUser   User?         @relation("InvitationAcceptee", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // At most one PENDING invitation per (project,email) is enforced by a partial
  // unique index created in the migration SQL (Prisma cannot express partial indexes).
  @@index([email, status])
  @@index([projectId, status])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id          String       @id @default(uuid())
  title       String
  description String       @default("")
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  comments    Comment[]
  tags        TaskTag[]
  activities  ActivityLog[]

  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([projectId, dueDate])
  @@index([assigneeId])
  @@index([creatorId])
}

model Tag {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  tasks TaskTag[]

  @@unique([projectId, name]) // case-normalised names are lower-cased before insert
}

model TaskTag {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

// ---------------------------------------------------------------------------
// Comments & Activity
// ---------------------------------------------------------------------------

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

// Append-only activity timeline. Written inside the same transaction as the
// operation it records, so events always reflect real successful operations.
// Deleted users keep their audit trail via Restrict + denormalised actorName.
model ActivityLog {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type        ActivityType
  actorId     String
  actor       User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorName   String // denormalised for retention after potential data purge
  message     String
  metadata    Json?
  createdAt   DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}
